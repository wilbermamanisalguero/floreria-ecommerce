{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"INSTRUCCION OBLIGATORIA: Responde al usuario en no mas de 100 palabras.\"}}'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__atlassian__createJiraIssue|mcp__atlassian__executeWrite",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/jira-dedup.js\"",
            "timeout": 60,
            "statusMessage": "Buscando tareas duplicadas en Jira..."
          }
        ]
      }
    ]
  }
}
